# Copy to .env.local and fill in from your Supabase project settings.

# Project Settings -> API. Both of these are safe in the browser: row level
# security and the dh_* functions are what protect the data, not the key.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=

# Project Settings -> Database -> Connection string -> URI (session pooler, 5432).
# Used only by `npm run migrate` and the test scripts, from your machine.
# NOT prefixed with VITE_, so it never reaches the browser. Never commit it.
SUPABASE_DB_URL=
